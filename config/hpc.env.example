# Connection (HPC_HOST and HPC_USER are required)
HPC_HOST=login.hpc.example
HPC_USER=gitlab_sim
HPC_SSH_PORT=22

# Absolute HPC-side paths. Use only letters, digits, /, ., _, and -.
HPC_WORK_ROOT=/project/my-team/gitlab-runs
HPC_CONTAINER=/approved/containers/hpc-rhel8.10-v1.sif

# Slurm site configuration. Blank optional values are omitted from sbatch.
SLURM_ACCOUNT=my-allocation
SLURM_PARTITION=compute
SLURM_QOS=
SLURM_TIME=00:30:00
SLURM_NODES=1
SLURM_TASKS=1
SLURM_CPUS=4
SLURM_MEMORY=4G

# CI wait behavior
SLURM_POLL_SECONDS=15
SLURM_WAIT_TIMEOUT_SECONDS=3600

# Simulation arguments must be a JSON array, not a shell command string.
SIM_ARGS=["--input","input.json"]

# Optional Apptainer binds: src[:dest[:opts]], comma-separated.
APPTAINER_EXTRA_BINDS=

# If true, delete the remote run directory after successful retrieval.
HPC_CLEANUP_ON_SUCCESS=false

# Vault values used only by MVP 5
VAULT_ADDR=https://vault.example.com
VAULT_AUTH_PATH=jwt
VAULT_ROLE=gitlab-hpc
VAULT_KV_MOUNT=kv
VAULT_SSH_SECRET_PATH=ci/hpc/ssh
VAULT_SSH_KEY_FIELD=private_key

